# Database
DATABASE_URL=postgresql://user:password@localhost:5432/foreignhousing

# NextAuth.js
NEXTAUTH_SECRET=your-nextauth-secret-here-change-this-in-production
NEXTAUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AWS Configuration
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET_NAME=foreign-housing-images-production

# CloudFront (Public)
NEXT_PUBLIC_CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net

# Email (SES)
EMAIL_SERVER_HOST=email-smtp.ap-northeast-1.amazonaws.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your-ses-smtp-username
EMAIL_SERVER_PASSWORD=your-ses-smtp-password
EMAIL_FROM=noreply@foreign-housing.com

# Google Maps API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Environment
NODE_ENV=development
