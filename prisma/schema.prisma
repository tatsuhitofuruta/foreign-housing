// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  locale        String    @default("en")
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts  Account[]
  sessions  Session[]
  reviews   Review[]
  favorites Favorite[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Application models
model Property {
  id          String       @id @default(cuid())
  title       String
  titleJa     String       @map("title_ja")
  description String       @db.Text
  descriptionJa String     @map("description_ja") @db.Text

  // Pricing
  price       Decimal      @db.Decimal(12, 2)
  currency    String       @default("JPY")

  // Property details
  propertyType PropertyType @map("property_type")
  bedrooms    Int
  bathrooms   Int
  areaSqm     Decimal      @map("area_sqm") @db.Decimal(8, 2)
  yearBuilt   Int          @map("year_built")
  floor       Int?
  totalFloors Int?         @map("total_floors")

  // Location
  address     String
  latitude    Decimal      @db.Decimal(10, 8)
  longitude   Decimal      @db.Decimal(11, 8)
  prefecture  String
  city        String
  ward        String?
  postalCode  String?      @map("postal_code")

  // Transit
  stationNearest    String  @map("station_nearest")
  stationLine       String? @map("station_line")
  stationWalkMinutes Int    @map("station_walk_minutes")

  // Media
  images      String[]
  videos      String[]     @default([])
  floorPlan   String?      @map("floor_plan")

  // Features
  amenities   String[]
  tags        String[]     @default([])

  // Status
  status      PropertyStatus @default(DRAFT)
  published   Boolean      @default(false)
  publishedAt DateTime?    @map("published_at")

  // SEO
  slug        String       @unique
  metaTitle   String?      @map("meta_title")
  metaDescription String?  @map("meta_description")

  // Stats
  viewCount   Int          @default(0) @map("view_count")
  inquiryCount Int         @default(0) @map("inquiry_count")

  // Timestamps
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  reviews     Review[]
  favorites   Favorite[]

  @@index([propertyType])
  @@index([prefecture, city])
  @@index([price])
  @@index([publishedAt])
  @@index([slug])
  @@map("properties")
}

model Review {
  id         String   @id @default(cuid())
  propertyId String   @map("property_id")
  userId     String   @map("user_id")

  // Ratings (1-5)
  ratingOverall    Int @map("rating_overall")
  ratingLocation   Int @map("rating_location")
  ratingFacilities Int @map("rating_facilities")
  ratingManagement Int @map("rating_management")
  ratingValue      Int @map("rating_value")

  // Content
  title    String
  comment  String   @db.Text
  images   String[] @default([])

  // Verification
  isVerified Boolean @default(false) @map("is_verified")
  moveInDate DateTime? @map("move_in_date")
  moveOutDate DateTime? @map("move_out_date")

  // Engagement
  helpfulCount Int @default(0) @map("helpful_count")

  // Status
  status   ReviewStatus @default(PENDING)

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  helpful  ReviewHelpful[]

  @@index([propertyId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("reviews")
}

model ReviewHelpful {
  id        String   @id @default(cuid())
  reviewId  String   @map("review_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@map("review_helpful")
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  propertyId String   @map("property_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
  @@map("favorites")
}

model Inquiry {
  id         String       @id @default(cuid())
  propertyId String?      @map("property_id")
  name       String
  email      String
  phone      String?
  message    String       @db.Text
  type       InquiryType  @default(GENERAL)
  status     InquiryStatus @default(NEW)

  // Response
  respondedAt DateTime? @map("responded_at")
  response    String?   @db.Text

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("inquiries")
}

// Enums
enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum PropertyType {
  APARTMENT
  HOUSE
  CONDO
  STUDIO
  TOWNHOUSE
  PENTHOUSE
}

enum PropertyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  RENTED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum InquiryType {
  GENERAL
  VIEWING
  APPLICATION
  COMPLAINT
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}
